{
  "name": "@kairotic/net",
  "version": "0.1.0",
  "description": "Kairotic in a shared room: share values on channels with everyone in it, and one tempo for the whole room (the same beat on every page)",
  "author": "bonuoq",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bonuoq/kairotic.git",
    "directory": "packages/net"
  },
  "homepage": "https://github.com/bonuoq/kairotic/tree/main/packages#readme",
  "type": "module",
  "main": "dist/index.mjs",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "kairotic": {
    "api": 1
  },
  "scripts": {
    "build": "node ../build.mjs net",
    "prepublishOnly": "node ../build.mjs net"
  },
  "keywords": [
    "kairotic",
    "music",
    "network",
    "webrtc",
    "tempo",
    "jam",
    "patcher"
  ]
}
