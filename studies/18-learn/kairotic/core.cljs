;; Kairotic · shared core
;; Utilities shared by all the studies: escaping text, encoding EDN ⇄ JSON
;; without evaluating anything, and the REPL where every gesture is written as code.

(ns kairotic.core
  (:require [clojure.string :as str]))

(defn esc [s]
  (-> (str s)
      (str/replace "&" "&amp;")
      (str/replace "<" "&lt;")
      (str/replace ">" "&gt;")
      (str/replace "\"" "&quot;")))

;; ───────── EDN ⇄ JSON (for saving in the db) ─────────
;; Keywords and maps are tagged so they come back as EDN without evaluating foreign code.

(defn enc [x]
  (cond (keyword? x) {"k" (name x)}
        (map? x) {"m" (mapv (fn [[k v]] [(enc k) (enc v)]) x)}
        (sequential? x) (mapv enc x)
        :else x))

(defn dec* [x]
  (cond (map? x) (cond (contains? x "k") (keyword (str (get x "k")))
                       (contains? x "m") (into {} (for [kv (get x "m") :when (and (sequential? kv) (= 2 (count kv)))]
                                                    [(dec* (first kv)) (dec* (second kv))]))
                       :else nil)
        (sequential? x) (mapv dec* x)
        :else x))

;; ───────── evaluation ─────────
;; All the code from the REPL and from gestures is evaluated in the `user` namespace,
;; where each page defines its commands.

(defn eval-str [code]
  (js/scittle.core.eval_string (str "(in-ns 'user)\n" code)))

;; ───────── REPL ─────────

(defonce repl-state (atom {:out nil :hist [] :hidx nil}))

(defn repl-print! [cls html]
  (when-let [out (some-> (:out @repl-state) (js/document.getElementById))]
    (let [d (js/document.createElement "div")]
      (set! (.-className d) cls)
      (set! (.-innerHTML d) html)
      (.appendChild out d)
      (set! (.-scrollTop out) (.-scrollHeight out)))))

(defn repl-eval!
  "Evaluates code and shows it in the REPL. `source` is :repl (typed) or :gesture (generated by the interface)."
  [code source]
  (repl-print! (str "in" (when (= source :gesture) " from-patch"))
               (str "<span class=\"p\">" (if (= source :gesture) "⟵" "λ") "</span>" (esc code)))
  (try
    (let [v (eval-str code)]
      (when (= source :repl) (repl-print! "out" (esc (pr-str v))))
      v)
    (catch :default e
      (repl-print! "err" (esc (or (.-message e) (str e))))
      nil)))

(defn gesture!
  "A gesture in the interface is written as code and evaluated: that way interface and code are the same thing."
  [code]
  (repl-eval! code :gesture))

(defn mount-repl!
  "Wires an input line and an output area (by id) as a REPL with ↑ ↓ history."
  [out-id in-id]
  (swap! repl-state assoc :out out-id)
  (let [inp (js/document.getElementById in-id)]
    (.addEventListener inp "keydown"
      (fn [e]
        (let [k (.-key e)]
          (cond
            (= k "Enter")
            (let [code (str/trim (.-value inp))]
              (when (seq code)
                (swap! repl-state (fn [s] (-> s (update :hist conj code) (assoc :hidx nil))))
                (set! (.-value inp) "")
                (repl-eval! code :repl)))
            (or (= k "ArrowUp") (= k "ArrowDown"))
            (let [{:keys [hist hidx]} @repl-state n (count hist)]
              (when (pos? n)
                (.preventDefault e)
                (let [i (if (= k "ArrowUp")
                          (if (nil? hidx) (dec n) (max 0 (dec hidx)))
                          (if (nil? hidx) nil (if (>= (inc hidx) n) nil (inc hidx))))]
                  (swap! repl-state assoc :hidx i)
                  (set! (.-value inp) (if (nil? i) "" (nth hist i))))))))))))
