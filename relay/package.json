  "author": "bonuoq",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bonuoq/kairotic.git",
    "directory": "relay"
  },
  "homepage": "https://github.com/bonuoq/kairotic/tree/main/relay#readme",
  "main": "server.js",
  "bin": {
